    "\n",
    "    new_h = (h // modulo) * modulo\n",
    "    new_w = (w // modulo) * modulo\n",
    "    cropped = data[..., :new_h, :new_w]\n",
    "\n",
    "    versions = []\n",
    "    for row_mod in range(modulo):\n",
